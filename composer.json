{
    "name": "packstub/filament-coedit",
    "description": "Edit Filament records together without locks: live presence down to the field someone is typing in, and saves that merge field by field instead of overwriting a colleague's changes. Polling, no websockets.",
    "keywords": [
        "packstub",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-v4",
        "filament-v5",
        "presence",
        "collaboration",
        "concurrent-editing",
        "optimistic-locking",
        "resource-lock",
        "record-lock",
        "livewire"
    ],
    "homepage": "https://github.com/packstub/filament-coedit",
    "support": {
        "issues": "https://github.com/packstub/filament-coedit/issues",
        "source": "https://github.com/packstub/filament-coedit",
        "docs": "https://packstub.dev/docs/filament-coedit"
    },
    "license": "MIT",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/icaliman"
        }
    ],
    "authors": [
        {
            "name": "Ion Caliman",
            "email": "icaliman92@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Packstub",
            "email": "support@packstub.dev",
            "homepage": "https://packstub.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.13.3 || ^5.8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-livewire": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Packstub\\CoEdit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packstub\\CoEdit\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:filter": "pest --filter",
        "lint": "pint",
        "lint:test": "pint --test",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packstub\\CoEdit\\CoEditServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
